rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Hàm kiểm tra user đã đăng nhập
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Hàm kiểm tra sở hữu dữ liệu
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // Hàm kiểm tra quyền Admin
    function isAdmin() {
      return request.auth != null && (
        (request.auth.token.email == 'longk2tha@gmail.com') ||
        (request.auth.token.email == 'maholong12a4@gmail.com')
      );
    }
    
    // === REGISTRATIONS (cho phép đọc public để hiển thị marquee) ===
    match /registrations/{docId} {
      allow read: if true;  // Public read cho marquee
      allow create: if isAuthenticated();
    }
    
    // === USER ACCESS ===
    match /userAccess/{docId} {
      allow read, write: if isAuthenticated();
    }

    // === FEEDBACK / HÒM THƯ GÓP Ý ===
    match /feedback/{docId} {
      allow read, write: if isAuthenticated();
      allow create: if true;  // Bất kỳ người dùng / khách nào cũng có thể gửi góp ý
    }
    
    // === ACTIVITY LOG ===
    match /activityLog/{docId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // === HISTORY (deprecated) ===
    match /history/{docId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // === USER CREDITS ===
    match /userCredits/{userId} {
      allow read: if isAdmin() || (isAuthenticated() && isOwner(userId));
      // Only the verified PayOS server or an administrator may increase a balance.
      // Owners may deduct their own credits; free-usage counters can be updated independently.
      allow create: if isAdmin() || (isAuthenticated() && isOwner(userId)
        && request.resource.data.userId == userId
        && (!('credits' in request.resource.data) || request.resource.data.credits == 0)
        && (!('plan' in request.resource.data) || request.resource.data.plan == 'free')
        && request.resource.data.keys().hasOnly(['userId', 'credits', 'plan', 'dailyFreeDate', 'dailyFreeUsed', 'lastUpdated']));
      allow update: if isAdmin() || (isAuthenticated() && isOwner(userId)
        && request.resource.data.userId == userId
        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dailyFreeDate', 'dailyFreeUsed', 'lastUpdated', 'userId'])
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['credits', 'plan', 'lastUpdated', 'userId'])
            && request.resource.data.credits is number
            && request.resource.data.credits >= 0
            && (('credits' in resource.data && resource.data.credits is number
                && request.resource.data.credits <= resource.data.credits)
                || (!('credits' in resource.data) && request.resource.data.credits == 0))
            && (request.resource.data.plan == resource.data.plan
                || (request.resource.data.plan == 'free' && request.resource.data.credits < 500)))));
      allow delete: if isAdmin();
    }
    
    // === APPROVED BILLS ===
    match /approvedBills/{docId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if isAdmin();
    }
    
    // === FAILED BILLS ===
    match /failedBills/{docId} {
      allow read, write: if isAuthenticated();
    }
    
    // === NOTIFICATIONS ===
    match /notifications/{docId} {
      allow read: if true;  // Public read để user thấy thông báo trước khi đăng nhập
      allow write: if isAuthenticated();  // Admin đã đăng nhập được tạo, sửa, xóa thông báo
    }
    
    // === CLOTHING TEMPLATES ===
    match /clothing_templates/{docId} {
      allow read: if isAuthenticated();  // User đăng nhập mới đọc được
      allow write: if isAuthenticated();  // Admin viết qua AdminPanel
    }
    
    // === SYSTEM SETTINGS (AI Proxy config - managed from AdminPanel) ===
    match /systemSettings/{docId} {
      allow read: if isAuthenticated();   // Tool clients (logged in) read config
      allow write: if isAuthenticated();  // Admin có thể lưu cấu hình
    }

    // === APP CONFIG (Terms, Announcements, etc.) ===
    match /appConfig/{docId} {
      allow read: if true;                // Public read để hiển thị điều khoản trước khi đăng ký
      allow write: if isAuthenticated();  // Admin cập nhật điều khoản và link Flow
    }

    // === CONTRIBUTED GOOGLE ACCOUNTS (Trạm nạp Quota Google) ===
    match /contributedGoogleAccounts/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
  }
}
