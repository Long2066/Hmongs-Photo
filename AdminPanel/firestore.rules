rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Hàm kiểm tra user đã đăng nhập
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Hàm kiểm tra sở hữu dữ liệu
    function isOwner(userId) {
      return request.auth.uid == userId;
    }
    
    // === REGISTRATIONS (cho phép đọc public để hiển thị marquee) ===
    match /registrations/{docId} {
      allow read: if true;  // Public read cho marquee
      allow create: if isAuthenticated();
    }
    
    // === USER ACCESS ===
    match /userAccess/{docId} {
      allow read, write: if isAuthenticated();
    }
    
    // === ACTIVITY LOG ===
    match /activityLog/{docId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // === HISTORY (deprecated) ===
    match /history/{docId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    // === USER CREDITS ===
    match /userCredits/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow write: if isAuthenticated() && isOwner(userId);
    }
    
    // === APPROVED BILLS ===
    match /approvedBills/{docId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }
    
    // === FAILED BILLS ===
    match /failedBills/{docId} {
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }
    
    // === NOTIFICATIONS ===
    match /notifications/{docId} {
      allow read: if true;  // Public read để user thấy thông báo trước khi đăng nhập
    }
    
    // === CLOTHING TEMPLATES (MỚI THÊM!) ===
    match /clothing_templates/{docId} {
      allow read: if isAuthenticated();  // User đăng nhập mới đọc được
      allow write: if isAuthenticated();  // Admin viết qua AdminPanel
    }
    // === SYSTEM SETTINGS (AI Proxy config - managed from AdminPanel) ===
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'longk2tha@gmail.com';
    }
    match /systemSettings/{docId} {
      allow read: if isAuthenticated();   // Tool clients (logged in) read config
      allow write: if isAdmin();          // Only admin can change config
    }
  }
}
